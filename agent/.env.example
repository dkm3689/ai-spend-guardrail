# ── Guardrail Agent config ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your real Anthropic API key — stays on this machine, never sent to the control plane
ANTHROPIC_API_KEY=sk-ant-...

# The sk-guard-... key from the Guardrail dashboard (project → Generate Agent Key)
GUARDRAIL_PROJECT_KEY=sk-guard-...

# URL of your deployed Guardrail control plane
GUARDRAIL_URL=https://your-guardrail-proxy.railway.app

# Port this agent listens on (your app points here instead of api.anthropic.com)
PORT=8002

# Optional: override Anthropic API URL (useful for testing with mock_anthropic.py)
# ANTHROPIC_API_URL=http://localhost:8001/v1/messages
