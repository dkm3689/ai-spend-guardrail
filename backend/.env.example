# Postgres connection string
# Local:      postgresql://guardrail:guardrail@localhost:5432/guardrail
# Supabase:   postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://guardrail:guardrail@localhost:5432/guardrail

# Redis URL
# Local:   redis://localhost:6379
# Upstash: rediss://<user>:<password>@<host>:6380
REDIS_URL=redis://localhost:6379

# Fernet encryption key for storing provider API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Master secret for /admin endpoints
ADMIN_SECRET=change-me-to-something-random

# Telegram bot token from @BotFather (leave empty to disable alerts)
TELEGRAM_BOT_TOKEN=

# Supabase JWT secret — Project Settings → API → JWT Secret
# Leave empty to disable auth (local dev mode — all requests share a fixed dev user ID)
SUPABASE_JWT_SECRET=
