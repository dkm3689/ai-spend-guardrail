# Postgres — Supabase connection string (Session mode, port 5432)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Upstash Redis
UPSTASH_REDIS_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_TOKEN=<your-token>

# Fernet encryption key for storing provider API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Master secret for /admin endpoints
ADMIN_SECRET=change-me-to-something-random

# Telegram bot token from @BotFather (leave empty to disable alerts)
TELEGRAM_BOT_TOKEN=

# Supabase JWT secret — Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
